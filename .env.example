# Copy to .env (which is gitignored) and fill in. Used by send-test.mjs.
#   cp .env.example .env
#   node --env-file=.env send-test.mjs
#
# App Password (16 chars), NOT your Google login password.
# Create one at https://myaccount.google.com/apppasswords (needs 2FA on).
GMAIL_USER=etan.cohn@gmail.com
GMAIL_APP_PASSWORD=your16charapppass
# Optional: send the test somewhere other than GMAIL_USER
# TO=someone@else.com

# ── Firebase web config (used by the React app: dashboard + post viewer) ──
# Firebase console → Project settings → "Your apps" → Web app → SDK config.
# These are public values (not secrets); access is controlled by security rules.
# Vite only exposes vars prefixed with VITE_.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=more-perfect-union-newsletter.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=more-perfect-union-newsletter
VITE_FIREBASE_STORAGE_BUCKET=more-perfect-union-newsletter.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
